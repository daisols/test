DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TZ=Asia/Shanghai

# Google Earth Engine
# Use either local authentication (`earthengine authenticate`) or provide a
# service-account email and JSON key file for unattended generation jobs.
EARTH_ENGINE_PROJECT=your-google-cloud-project-id
# EARTH_ENGINE_SERVICE_ACCOUNT=fieldmoist-ee@your-google-cloud-project-id.iam.gserviceaccount.com
# EARTH_ENGINE_CREDENTIALS_FILE=credentials/earth-engine-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=credentials/earth-engine-service-account.json

# NASA POWER is a public API and does not require an account or API key.
# NASA Earthdata credentials are not used by the current POWER integration.
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT_SECONDS=20
NASA_POWER_USER_AGENT=FieldMoist/1.0 (contact: your-email@example.org)
# NASA_EARTHDATA_USERNAME=your-earthdata-username
# NASA_EARTHDATA_PASSWORD=replace-me

# SQLite is the default and needs no additional settings.
DB_ENGINE=sqlite
# SQLITE_PATH=backend/db.sqlite3

# Optional MySQL configuration:
# DB_ENGINE=mysql
# DB_NAME=fieldmoist
# DB_USER=fieldmoist
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Optional external media directory:
# FIELD_MOIST_MEDIA_ROOT=E:/FieldMoistData/media

# Optional standalone raster-processing script paths:
# FIELD_MOIST_S1_INPUT_DIR=data/sentinel1
# FIELD_MOIST_S2_PARAMETER_DIR=data/parameter4
# FIELD_MOIST_COMBINED_OUTPUT_DIR=data/parameters

# Temporal-fusion G stage (inverse | patch_excel | ml_all).
# patch_excel uses Excel lon/lat only when a compatible model is supplied;
# without a model, valid MSM values are required for the training fallback.
# FIELDMOIST_G_MODE=inverse
# FIELDMOIST_G_ML_MODEL_PATH=E:/FieldMoistData/models/shared_ml_model_rf.pkl
# FIELDMOIST_G_ML_SHARE_MODEL=true
# FIELDMOIST_G_ML_FALLBACK_TO_INVERSE=true
